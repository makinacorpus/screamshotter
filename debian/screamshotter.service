[Unit]
Description=Screamshotter
StartLimitIntervalSec=30
StartLimitBurst=2

[Service]
WorkingDirectory=/opt/screamshotter
ExecStart=/opt/screamshotter/bin/gunicorn --config=/opt/screamshotter/conf/gunicorn-screamshotter.conf.py screamshotter.wsgi:application
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/screamshotter/playwright/
Environment=HOME=/opt/screamshotter
Environment=PATH=/opt/screamshotter/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
User=screamshotter
Group=screamshotter
UMask=002

[Install]
WantedBy=multi-user.target
